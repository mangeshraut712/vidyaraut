# OpenRouter API Configuration (Server-side only - NOT exposed to client)
# Add this in Vercel Environment Variables
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Specify which model to use (server-side)
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Site Configuration (for OpenRouter HTTP-Referer header)
# On Vercel, VERCEL_URL is auto-set, so this is optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Vidya Raut Portfolio
