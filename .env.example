# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000/vidyaraut
NEXT_PUBLIC_SITE_NAME=Vidya Raut Portfolio
# Optional: enable live chat on the static site by pointing at a hosted FastAPI/chat endpoint.
NEXT_PUBLIC_CHAT_API_URL=

# OpenAI Responses API
# Optional: if set, the chatbot will prefer OpenAI's newer Responses API path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Optional FastAPI backend for chatbot and other AI features
# Replace this with your deployed FastAPI service URL or use http://127.0.0.1:8000 locally
FASTAPI_URL=
# Optional shared secret for FastAPI when self-hosting chat
FASTAPI_INTERNAL_TOKEN=

# Optional upstream chat endpoint for a self-hosted Node or FastAPI chat service.
CHAT_UPSTREAM_URL=
